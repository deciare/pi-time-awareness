{
	"name": "pi-time-awareness",
	"version": "0.1.0",
	"type": "module",
	"description": "Prefix user messages with their local send time, and optionally name the current time in the system prompt.",
	"keywords": [
		"pi",
		"pi-package",
		"pi-coding-agent",
		"timestamps",
		"time"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"pi-time-awareness.example.json"
	],
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "26.6.5",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*"
	}
}
